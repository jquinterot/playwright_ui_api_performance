{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {
        "NODE_ENV": "development",
        "PLAYWRIGHT_MCP_BROWSER": "chromium",
        "PLAYWRIGHT_MCP_HEADLESS": "true"
      }
    },
    "playwright-headed": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless=false"
      ],
      "env": {
        "NODE_ENV": "development",
        "PLAYWRIGHT_MCP_BROWSER": "chromium"
      }
    },
    "playwright-debug": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless=false",
        "--caps=network,storage,devtools",
        "--console-level=debug",
        "--snapshot-mode=full"
      ],
      "env": {
        "NODE_ENV": "development",
        "PLAYWRIGHT_MCP_BROWSER": "chromium"
      }
    }
  }
}
